# Скопируй в .env и подставь свои значения.

# Интервал автоматического опроса сети (минуты)
SCAN_INTERVAL_MINUTES=15

# Порт веб-дашборда (внутри контейнера)
WEB_PORT=8000

# Адрес MCP-шлюза лаборатории (Docker AI MCP Gateway с MikroTik и др.)
# Если недоступен — агент автоматически работает на демо-заглушках.
LAB_MCP_URL=http://192.168.0.61:8100/sse

# Границы пользовательской сети: только с этих интерфейсов и подсетей
# устройства считаются «нашими» (фильтр WAN, туннелей, APIPA, CGNAT).
LAN_INTERFACES=bridge1-lan
LAN_SUBNETS=192.168.0.0/16

# --- Уведомления о новых теневых устройствах по email (SMTP) ---
# Для Яндекса: включите «пароли приложений» (yandex.ru/id → Безопасность),
# создайте пароль для Почты и вставьте его сюда. Пароль аккаунта НЕ подойдёт.
# Внимание: сети с блокировкой исходящего SMTP (25/465/587, например
# университетские) не пропустят письма — сервер должен быть вне такой сети.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=prutskiyalex@yandex.ru
SMTP_PASSWORD=
MAIL_TO=prutskiyalex@yandex.ru

# --- Опционально: LLM для планировщика и классификации устройств ---
# Без LLM_API_KEY агент работает в детерминированном режиме (фиксированный
# план + эвристическая классификация) — всё остальное функционирует полностью.
# Kimi (OpenAI-совместимый API):
# LLM_API_KEY=<ключ с platform.kimi.ai>
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_MODEL=kimi-k2.6
